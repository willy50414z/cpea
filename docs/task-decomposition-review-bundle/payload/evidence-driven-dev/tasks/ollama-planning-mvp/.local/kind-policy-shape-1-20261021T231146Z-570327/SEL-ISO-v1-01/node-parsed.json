  "draft": {
    "status": "ready",
    "strategy": "multi_view",
    "tasks": [
      {
        "task_id": "task_inventory",
        "view": "demo_retail.v_inventory_status",
        "required_columns": [
          "store_id",
          "product_id",
          "stock_qty",
          "snapshot_date"
        ],
        "filters": [],
        "metrics": {
          "stock_qty": "sum"
        },
        "conditional_metrics": [],
        "attributes": [],
        "metadata_collections": [
          "snapshot_date"
        ],
        "group_by": [
          "store_id",
          "product_id"
        ],
        "output_grain": [
          "store_id",
          "product_id"
        ],
        "depends_on": [],
        "unbound_inputs": [],
        "request": "從 v_inventory_status 取門市×商品粒度的盤點庫存件數(stock_qty)加總與庫存盤點日期(snapshot_date)，保留所有庫存商品作為母體。"
      },
      {
        "task_id": "task_sales",
        "view": "demo_retail.v_sales_detail",
        "required_columns": [
          "store_id",
          "product_id",
          "discount_amount",
          "net_sales",
          "order_date",
          "sales_channel"
        ],
        "filters": [
          {
            "column": "order_date",
            "operator": ">=",
            "value": "2026-09-01"
          },
          {
            "column": "order_date",
            "operator": "<",
            "value": "2026-10-01"
          },
          {
            "column": "sales_channel",
            "operator": "=",
            "value": "online"
          }
        ],
        "metrics": {
          "discount_amount": "sum",
          "net_sales": "sum"
        },
        "conditional_metrics": [],
        "attributes": [],
        "metadata_collections": [],
        "group_by": [
          "store_id",
          "product_id"
        ],
        "output_grain": [
          "store_id",
          "product_id"
        ],
        "depends_on": [],
        "unbound_inputs": [],
        "request": "從 v_sales_detail 篩選 order_date 在 2026-09-01(含)至 2026-10-01(不含) 且 sales_channel=online 的訂單明細，按門市×商品彙總折扣金額(discount_amount)與淨銷售額(net_sales)。"
      }
    ],
    "integration": {
      "anchor_task": "task_inventory",
      "output_grain": [
        "store_id",
        "product_id"
      ],
      "edges": [
        {
          "left_task": "task_inventory",
          "right_task": "task_sales",
          "left_keys": [
            "store_id",
            "product_id"
          ],
          "right_keys": [
            "store_id",
            "product_id"
          ],
          "mode": "left",
          "cardinality": "one_to_one",
          "preserve_task": "task_inventory"
        }
      ],
      "preparation": [
        {
          "task_id": "task_sales",
          "kind": "aggregate",
          "keys": [
            "store_id",
            "product_id"
          ],
          "description": "將 v_sales_detail 自訂單明細粒度彙總至門市×商品粒度，以 store_id、product_id 對齊左母體"
        }
      ],
      "missing_data_policy": "保留未匹配資料並標記缺值；契約沒有保證時不可把缺值當成零。",
      "notes": [
        "無線上通路銷售的庫存商品，折扣金額與淨銷售額以缺值呈現，不補零。"
      ]
    },
