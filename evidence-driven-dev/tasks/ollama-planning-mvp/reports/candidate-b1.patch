@@ -0,0 +1,170 @@
+"""Explicit Azure-only paired experiment; no automatic retries or stage upgrades."""
+from __future__ import annotations
+
+import argparse
+from dataclasses import replace
+from datetime import datetime, timezone
+from hashlib import sha256
+import json
+import os
+from pathlib import Path
+from time import monotonic
+from uuid import uuid4
+
+from langchain_core.messages import SystemMessage, HumanMessage
+from cpea.application.models.decomposition import DecompositionDraft
+from cpea.application.services.task_decomposition import TaskDecompositionService
+from cpea.infrastructure.catalog.yaml_catalog import SchemaCatalog
+from cpea.infrastructure.llm.context_budget import TiktokenCounter
+from cpea.infrastructure.llm.factory import get_llm_config
+from cpea.infrastructure.llm.parsing import parse_model
+from cpea.workflows.task_decomposition.prompt import DECOMPOSITION_PROMPT
+from evaluations.decomposition_grading import grade_decomposition
+from evaluations.decomposition_runner import azure_planning_settings
+from evaluations.planning_mvp import VERSION, SemanticPlan, compile_plan, finish, semantic_check
+
+
+TASK = Path('evidence-driven-dev/tasks/ollama-planning-mvp')
+SELECTED = ('cross-view-02','cross-view-07','cross-view-09','cross-view-14','cross-view-16','cross-view-28')
+PROMPT = '''你只準備單一 View 查詢與跨來源整合計畫，不產生 SQL、不查資料、不作業務決策。輸出符合 SemanticPlan 的 JSON。
+語意選擇由你完成：選足夠且必要來源，完整覆蓋需求欄位、條件、期間、母體及根與子集合粒度；不得靠程式補救未表達語意。
+tasks.query_grain 是各來源查詢結果的鍵；root_grain 是最終母體的鍵，二者分開。原值放attributes；聚合放metrics，key必須是真實來源欄位，不是order_count等自創別名。條件計數放conditional_metrics，不能用全域filter刪除零符合的母體。所有期間及通路都放型別filters；View無該條件欄位就選具能力的合法來源，不能刪條件。
+links 明示parent、child、各自對齊鍵、mode、shape與cardinality。保留所有母體用anchor向child的left；細粒度子集合shape=collection，child query_grain保留日期／商品／通路維度，但child_keys是收集至parent的對齊鍵，不是完整子粒度。已唯一對齊可merge；較粗來源背景用context且不得按商品重加總。不得任意丟維度或用aggregate抹掉子集合。
+程式將依型別欄位生成required_columns、group_by、單View request及integration preparation，勿重複輸出這些結構。
+庫存原始店×商品有唯一鍵，盤點日期以attribute同列保留；庫存彙總成本或條件計數時用metadata_collections完整記錄snapshot_date，metadata不增加分組。禁止跨不同快照日期加總stock_qty；metadata不能證明同日。對明示來源完整鍵或已固定月份才可證明原值唯一；銷售明細(order_id,product_id)唯一性證據有爭議，不用它證明FD或COUNT等價；明細訂單數使用count_distinct。
+保留契約既有NULL與0；未匹配數值不能補零。missing_values=preserve_null，明示子集合可empty_collection但不能製造零值子列。不得新增未要求度量或把欄位只留在filters卻漏選需求要求的輸出。來源能力不足則unsupported；必要語意不明才needs_clarification，寫明原因；不能因需要nest或已有契約旗標就要求使用者重定義。
+七個完整View契約都在輸入中。只輸出JSON，不輸出推理。'''
+
+
+def digest(path):
+    return sha256(path.read_bytes()).hexdigest()
+
+
+def messages(case, catalog):
+    return [SystemMessage(content=PROMPT), HumanMessage(content=json.dumps({
+        'request':case['request'], 'views':[{'view':v.name, **v.policy} for v in catalog.views()],
+        'response_schema':SemanticPlan.model_json_schema()}, ensure_ascii=False))]
+
+
+def freeze(catalog, cases):
+    files = ['evaluations/planning_mvp.py','evaluations/planning_mvp_runner.py',
+             'src/cpea/workflows/task_decomposition/validation.py','src/cpea/workflows/task_decomposition/prompt.py',
+             'evaluations/decomposition_grading.py']
+    return {'version':VERSION, 'catalog':catalog.fingerprint, 'source_hashes':{p:digest(Path(p)) for p in files},
+            'schema_sha256':sha256(json.dumps(SemanticPlan.model_json_schema(),sort_keys=True).encode()).hexdigest(),
+            'prompt_sha256':sha256(PROMPT.encode()).hexdigest(),
+            'baseline_prompt_sha256':sha256(DECOMPOSITION_PROMPT.encode()).hexdigest(),
+            'cases_sha256':sha256(json.dumps(cases,ensure_ascii=False,sort_keys=True).encode()).hexdigest()}
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--execute', action='store_true', help='明確允許最多12次DeepSeek呼叫；預設只preflight')
+    args = parser.parse_args(argv)
+    catalog = SchemaCatalog(Path('projects/retail'))
+    rows = [json.loads(s) for s in Path('projects/retail/evaluations/task_decomposition_cases.jsonl').read_text(encoding='utf-8').splitlines()]
+    cases = [next(c for c in rows if c['case_id'] == name) for name in SELECTED]
+    counter = TiktokenCounter('cl100k_base')
+    tokens = {c['case_id']:counter.count_messages([(m.type,m.content) for m in messages(c,catalog)]) for c in cases}
+    frozen = freeze(catalog,cases)
+    print(json.dumps({'preflight_tokens':tokens,'candidate_input_limit':8192,'output_limit':7168,'safety':1024,
+                      'fingerprints':frozen,'execute':args.execute},ensure_ascii=False),flush=True)
+    if max(tokens.values()) > 8192:
+        raise ValueError('context budget exceeded; no provider constructed')
+    if not args.execute:
+        return 0
+    review = json.loads((TASK/'agents/oracle-audit/review-manifest.json').read_text(encoding='utf-8'))
+    if review['catalog_fingerprint'] != catalog.fingerprint or review['approved_case_count'] != 30:
+        raise ValueError('oracle approval fingerprint mismatch')
+    approved = {c['case_id']:c for c in review['cases']}
+    if any(approved[c['case_id']]['case_sha256'] != c['case_sha256'] for c in cases):
+        raise ValueError('case approval fingerprint mismatch')
+    started = monotonic()
+    folder = TASK / '.local' / ('mvp1-b1-' + datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ') + '-' + uuid4().hex[:6])
+    folder.mkdir(mode=0o700, parents=True, exist_ok=False)
+    def dump(name,value):
+        (folder/name).write_text(json.dumps(value,ensure_ascii=False,indent=2)+'\n',encoding='utf-8')
+    settings = replace(azure_planning_settings(Path('.env'),'DeepSeek-V4.1-Flash'), request_timeout_seconds=300)
+    if settings.context_window != 16384:
+        raise ValueError('unexpected context window')
+    candidate_settings = replace(settings,max_output_tokens=7168,context_safety_tokens=1024)
+    baseline_llm = get_llm_config(settings=settings)
+    candidate_llm = get_llm_config(settings=candidate_settings).bind(response_format={'type':'json_object'})
+    metadata = {'stage':'MVP1','model':'DeepSeek-V4.1-Flash','provider':'azure','fingerprints':frozen,
+        'temperature':settings.temperature,'top_p':settings.top_p,'seed':settings.seed,'sdk_retries':0,
+        'timeout':300,'wall_budget_seconds':900,'call_limit':12,'model_calls':0,'output_limit_candidate':7168,
+        'output_limit_baseline':settings.max_output_tokens,'input_token_count':tokens,'token_counter':counter.name,
+        'started_at':datetime.now(timezone.utc).isoformat(),'output_reserve':7168,'generated_token_budget':12*7168}
+    dump('run.json',metadata)
+    results, calls = [], []
+    stopped = None
+    generated = 0
+    try:
+        for index,c in enumerate(cases):
+            order = ('v3','B1') if index % 2 == 0 else ('B1','v3')
+            for arm in order:
+                if freeze(catalog,cases) != frozen:
+                    raise RuntimeError('frozen source changed during experiment')
+                # Do not start a request whose full timeout exceeds the stage window.
+                if 900-(monotonic()-started) < 300 or metadata['model_calls'] >= 12 or generated >= 12*7168:
+                    raise RuntimeError('experiment budget exhausted')
+                call_start = monotonic(); current=[]; plan=None
+                metadata['model_calls'] += 1
+                dump('run.json',metadata)
+                if arm == 'v3':
+                    service = TaskDecompositionService(baseline_llm,catalog,settings=settings,token_counter=counter,observer=current.append)
+                    response = service.plan(c['request'])
+                    if len(current) != 1:
+                        raise RuntimeError('baseline did not issue exactly one call')
+                    event = current[0]
+                else:
+                    msgs = messages(c,catalog)
+                    event = {'messages':[{'role':m.type,'content':m.content} for m in msgs]}
+                    try:
+                        raw = candidate_llm.invoke(msgs)
+                    except Exception as exc:
+                        event.update(error_type=type(exc).__name__,error=str(exc))
+                        response = None
+                    else:
+                        event.update(response=raw.content,usage=getattr(raw,'usage_metadata',None))
+                        try:
+                            plan = parse_model(raw,SemanticPlan)
+                            draft = compile_plan(plan,catalog)
+                            response = finish(draft,catalog,guard=True)
+                        except (ValueError,TypeError,KeyError) as exc:
+                            response = None
+                            event['parse_compile_error'] = str(exc)
+                event.update(case_id=c['case_id'],arm=arm,elapsed_seconds=monotonic()-call_start)
+                calls.append(event)
+                with (folder/'calls.jsonl').open('a',encoding='utf-8') as f:f.write(json.dumps(event,ensure_ascii=False)+'\n')
+                os.chmod(folder/'calls.jsonl',0o600)
+                generated += (event.get('usage') or {}).get('output_tokens',0)
+                row = {'case_id':c['case_id'],'arm':arm,'response':response.model_dump() if response else None,
+                       'semantic_plan':plan.model_dump() if plan else None,
+                       'original_score':grade_decomposition(c,response,catalog) if response else None,
+                       'diagnostic':semantic_check(c,response,catalog) if response else {'safe':False,'errors':['parse/compile/provider']}}
+                results.append(row)
+                with (folder/'results.jsonl').open('a',encoding='utf-8') as f:f.write(json.dumps(row,ensure_ascii=False)+'\n')
+                metadata.update(elapsed_seconds=monotonic()-started,generated_tokens=generated,completed=len(results))
+                dump('run.json',metadata)
+                print(json.dumps({'case_id':c['case_id'],'arm':arm,'call':metadata['model_calls'],
+                                  'status':response.status if response else 'error','diagnostic':row['diagnostic']},ensure_ascii=False),flush=True)
+                if 'error' in event:
+                    (folder/'provider-error.txt').write_text(event['error_type']+': '+event['error']+'\n',encoding='utf-8')
+                    raise RuntimeError('provider error; no retry; inspect private provider-error.txt')
+                # The first two complete questions establish actual stage latency.
+            if index == 1 and monotonic()-started > 300:
+                raise RuntimeError('initial two-question latency exceeds stage projection')
+    except RuntimeError as exc:
+        stopped = str(exc)
+    finally:
+        metadata.update(stopped=stopped,finished_at=datetime.now(timezone.utc).isoformat(),elapsed_seconds=monotonic()-started,
+                        results_sha256=digest(folder/'results.jsonl') if (folder/'results.jsonl').exists() else None,
+                        calls_sha256=digest(folder/'calls.jsonl') if (folder/'calls.jsonl').exists() else None)
+        dump('run.json',metadata)
+        print(json.dumps({'output':str(folder),'calls':metadata['model_calls'],'completed':len(results),'stopped':stopped},ensure_ascii=False),flush=True)
+    return 1 if stopped else 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
