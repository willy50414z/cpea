# Copy to your own .env and explicitly select it with --env-file or CPEA_ENV_FILE.
# Process environment overrides this file, except datasource IDs fixed by project names.
ASSISTANT_LLM_PROVIDER=ollama
ASSISTANT_LLM_BASE_URL=http://localhost:11434
ASSISTANT_LLM_MODEL=gemma4
ASSISTANT_LLM_NUM_CTX=4096
ASSISTANT_LLM_NUM_PREDICT=512
# Ollama thinking is opt-in; reserve enough output tokens for final JSON.
ASSISTANT_LLM_REASONING=false
ASSISTANT_LLM_TOP_P=1.0
ASSISTANT_LLM_TIMEOUT_SECONDS=120
ASSISTANT_EMBEDDING_PROVIDER=ollama
ASSISTANT_EMBEDDING_MODEL=nomic-embed-text
ASSISTANT_RETRIEVAL_MODE=vector
ASSISTANT_RETRIEVAL_K=15
ASSISTANT_RERANKER_PROVIDER=lexical
ASSISTANT_RERANK_TOP_K=4
ASSISTANT_MAX_ROWS=200
# Explicitly select a profile. This checkout's synthetic example is not customer data.
# CPEA_DEPLOYMENT_FILE=config/tenants/example.yaml
# Web project selector loads projects/gms2/.env and projects/retail/.env.
CPEA_PROJECTS_ROOT=projects
# CPEA_PROFILE_PATH=projects/gms2
# Project datasource IDs are derived from the project directory name.
# Credentials are deployment-only values, excluded from source/distributions.
# ASSISTANT_LLM_API_KEY=replace-with-deployment-secret
# ASSISTANT_EMBEDDING_API_KEY=replace-with-deployment-secret
# For Azure OpenAI-compatible deployments, set ASSISTANT_LLM_PROVIDER=azure,
# ASSISTANT_LLM_BASE_URL, ASSISTANT_LLM_API_KEY, and ASSISTANT_LLM_MODEL.
# Matrix runs can instead use CPEA_AZURE_LLM_BASE_URL and CPEA_AZURE_LLM_API_KEY.
# For Google Vertex AI, set ASSISTANT_LLM_PROVIDER=gcp, CPEA_GCP_PROJECT,
# optionally CPEA_GCP_LOCATION, and configure ADC or ASSISTANT_LLM_API_KEY.
# Matrix runs may use CPEA_GCP_LLM_API_KEY; leave it unset when using ADC.

# SQL Server（SQLAlchemy mssql+pymssql URL） adapter settings (planned; fill in your deployment values).
# Blank connection string keeps the built-in adapter disabled.
# Blank timeouts will default to 5 seconds for login and 30 seconds for queries.
# Example: CPEA_SQLSERVER_CONNECTION_STRING='mssql+pymssql://YOUR_USER:YOUR_PASSWORD@server.example:1433/YOUR_DATABASE'
CPEA_SQLSERVER_CONNECTION_STRING=
CPEA_SQLSERVER_CONNECT_TIMEOUT_SECONDS=
CPEA_SQLSERVER_QUERY_TIMEOUT_SECONDS=

# Optional FreeTDS TLS configuration; blank uses bundled system CA verification.
FREETDSCONF=

# Optional writable vocabulary sidecar; relative to the selected env file.
# Default: <selected profile>/terms_mapping.json. Use one application worker.
# CPEA_TERMS_MAPPING_PATH=/protected/data/terms_mapping.json
